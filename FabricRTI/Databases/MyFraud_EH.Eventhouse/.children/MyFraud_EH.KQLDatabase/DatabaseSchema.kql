// =============================================================================
// MyFraud_EH KQL Database Schema
// =============================================================================
// This script provisions the two tables used by the real-time fraud demo:
//
//   1. Customers       — Seeded once by the Generate_Customers notebook.
//                        Holds cardholder profiles + Entra ID identities.
//                        Joined by Generate_Credit_Card_Transactions to
//                        enrich each event with email + display_name.
//
//   2. CCTransactions  — Continuously populated by the Eventstream
//                        (CreditCardTransactions_es) using ProcessedIngestion
//                        from a Custom App / Event Hub source.
//
// JSON ingestion mappings are provided for both tables so the
// Generate_Customers notebook (queued ingest) and ad-hoc SDK ingests bind to
// the right columns regardless of payload order. The Eventstream destination
// auto-maps JSON fields to columns by name and does not require a mapping
// reference.
// =============================================================================


// -----------------------------------------------------------------------------
// Customers table
// -----------------------------------------------------------------------------
.create-merge table Customers (
    user_id: string,
    first_name: string,
    last_name: string,
    display_name: string,
    user_principal_name: string,
    email: string,
    age: int,
    gender: string,
    street_address: string,
    home_city: string,
    home_state: string,
    postal_code: string,
    country_code: string,
    country: string,
    home_lat: real,
    home_lon: real,
    credit_limit: real,
    account_created: datetime
)

.create-or-alter table Customers ingestion json mapping 'Customers_mapping'
```
[
    {"column": "user_id",              "Properties": {"Path": "$.user_id"}},
    {"column": "first_name",           "Properties": {"Path": "$.first_name"}},
    {"column": "last_name",            "Properties": {"Path": "$.last_name"}},
    {"column": "display_name",         "Properties": {"Path": "$.display_name"}},
    {"column": "user_principal_name",  "Properties": {"Path": "$.user_principal_name"}},
    {"column": "email",                "Properties": {"Path": "$.email"}},
    {"column": "age",                  "Properties": {"Path": "$.age"}},
    {"column": "gender",               "Properties": {"Path": "$.gender"}},
    {"column": "street_address",       "Properties": {"Path": "$.street_address"}},
    {"column": "home_city",            "Properties": {"Path": "$.home_city"}},
    {"column": "home_state",           "Properties": {"Path": "$.home_state"}},
    {"column": "postal_code",          "Properties": {"Path": "$.postal_code"}},
    {"column": "country_code",         "Properties": {"Path": "$.country_code"}},
    {"column": "country",              "Properties": {"Path": "$.country"}},
    {"column": "home_lat",             "Properties": {"Path": "$.home_lat"}},
    {"column": "home_lon",             "Properties": {"Path": "$.home_lon"}},
    {"column": "credit_limit",         "Properties": {"Path": "$.credit_limit"}},
    {"column": "account_created",      "Properties": {"Path": "$.account_created"}}
]
```


// -----------------------------------------------------------------------------
// CCTransactions table
// -----------------------------------------------------------------------------
// Column names must match the JSON field names produced by
// Generate_Credit_Card_Transactions so that the Eventstream's
// ProcessedIngestion destination can auto-map fields to columns.
//
// The notebook sets the per-event time field as `stream_timestamp` (ISO 8601).
// -----------------------------------------------------------------------------
.create-merge table CCTransactions (
    transaction_id: string,
    user_id: string,
    email: string,
    display_name: string,
    stream_timestamp: datetime,
    amount: real,
    merchant_name: string,
    merchant_category: string,
    merchant_city: string,
    merchant_state: string,
    merchant_lat: real,
    merchant_lon: real,
    is_fraud: int,
    fraud_type: string,
    distance_from_home_km: real,
    hour_of_day: int,
    day_of_week: int,
    time_since_last_txn_sec: real,
    rolling_avg_amount: real,
    amount_zscore: real,
    txn_count_last_1h: int,
    txn_count_last_24h: int
)

.create-or-alter table CCTransactions ingestion json mapping 'CCTransactions_mapping'
```
[
    {"column": "transaction_id",          "Properties": {"Path": "$.transaction_id"}},
    {"column": "user_id",                 "Properties": {"Path": "$.user_id"}},
    {"column": "email",                   "Properties": {"Path": "$.email"}},
    {"column": "display_name",            "Properties": {"Path": "$.display_name"}},
    {"column": "stream_timestamp",        "Properties": {"Path": "$.stream_timestamp"}},
    {"column": "amount",                  "Properties": {"Path": "$.amount"}},
    {"column": "merchant_name",           "Properties": {"Path": "$.merchant_name"}},
    {"column": "merchant_category",       "Properties": {"Path": "$.merchant_category"}},
    {"column": "merchant_city",           "Properties": {"Path": "$.merchant_city"}},
    {"column": "merchant_state",          "Properties": {"Path": "$.merchant_state"}},
    {"column": "merchant_lat",            "Properties": {"Path": "$.merchant_lat"}},
    {"column": "merchant_lon",            "Properties": {"Path": "$.merchant_lon"}},
    {"column": "is_fraud",                "Properties": {"Path": "$.is_fraud"}},
    {"column": "fraud_type",              "Properties": {"Path": "$.fraud_type"}},
    {"column": "distance_from_home_km",   "Properties": {"Path": "$.distance_from_home_km"}},
    {"column": "hour_of_day",             "Properties": {"Path": "$.hour_of_day"}},
    {"column": "day_of_week",             "Properties": {"Path": "$.day_of_week"}},
    {"column": "time_since_last_txn_sec", "Properties": {"Path": "$.time_since_last_txn_sec"}},
    {"column": "rolling_avg_amount",      "Properties": {"Path": "$.rolling_avg_amount"}},
    {"column": "amount_zscore",           "Properties": {"Path": "$.amount_zscore"}},
    {"column": "txn_count_last_1h",       "Properties": {"Path": "$.txn_count_last_1h"}},
    {"column": "txn_count_last_24h",      "Properties": {"Path": "$.txn_count_last_24h"}}
]
```


